# Actual values are generated in .env by tools/init_env.py. Do not commit .env.
ADMIN_TOKEN=replace-with-at-least-32-random-characters
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex
BIND_IP=0.0.0.0
PORT=8080
# Only needed with compose.external.yml. URL-encode special characters in passwords.
# DATABASE_URL=mysql+pymysql://goldwatch:URL_ENCODED_PASSWORD@YOUR_MYSQL_HOST:3306/goldwatch?charset=utf8mb4
