HOST=127.0.0.1
PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=goldwatch
MYSQL_USER=goldwatch
# Use the actual password of the existing Baota database user.
MYSQL_PASSWORD="请填写宝塔数据库实际密码"
ADMIN_TOKEN=run-npm-run-setup-to-generate-a-random-token
MODE=live
COLLECTOR_ENABLED=true
# Optional: existing DATABASE_URL is supported, but separate MYSQL_* fields are easier.
# DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/goldwatch
# Dynamic pages need a local Chromium executable, not Docker or Python.
CHROMIUM_PATH=
PLAYWRIGHT_BROWSERS_PATH=.browsers
